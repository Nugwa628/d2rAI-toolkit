#!/bin/sh
# Pre-commit hook: refuse to commit anything the public-release scanner objects to.
# Installed by tools/install_hooks.py. Scans the staged content only; private terms come from a file outside the
# repository (see tools/check_public.py). Bypass in an emergency with: git commit --no-verify
root=$(git rev-parse --show-toplevel) || exit 1
for py in python3 python "py -3"; do
	if $py -c "import sys; sys.exit(sys.version_info < (3, 9))" >/dev/null 2>&1; then
		exec $py "$root/tools/check_public.py" --root "$root" --staged --quiet
	fi
done
echo "pre-commit: no Python 3 found, cannot run tools/check_public.py" >&2
exit 1
